    "敏感内容仅保存在本机设置和系统凭据存储中。" : {
      "comment" : "Short privacy note for local credential storage.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ المحتوى الحساس محليًا فقط في إعدادات الجهاز وتخزين بيانات الاعتماد النظامي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensible Inhalte werden nur in den lokalen Einstellungen und im System-Anmeldedatenspeicher gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitive content is saved only in local settings and the system credential store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido sensible se guarda solo en los ajustes locales y el almacén de credenciales del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu sensible est stocké uniquement dans les réglages locaux et le trousseau système."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संवेदनशील सामग्री केवल इस उपकरण की सेटिंग्स और सिस्टम क्रेडेंशियल स्टोरेज में सहेजी जाती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten sensitif hanya disimpan di pengaturan lokal dan penyimpanan kredensial sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti sensibili sono salvati solo nelle impostazioni locali e nell'archivio credenziali di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機密コンテンツはこのデバイスの設定とシステム認証情報ストレージにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "민감한 콘텐츠는 기기 설정 및 시스템 자격 증명 저장소에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevoelige inhoud wordt alleen lokaal opgeslagen in instellingen en systeemcredentialopslag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrażliwe treści są przechowywane tylko w ustawieniach lokalnych i magazynie poświadczeń systemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteúdo sensível é salvo apenas nas configurações locais e no armazenamento de credenciais do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфиденциальные данные хранятся только в локальных настройках и системном хранилище учётных данных."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hassas içerik yalnızca cihaz ayarlarında ve sistem kimlik bilgisi deposunda saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung nhạy cảm chỉ được lưu trong cài đặt thiết bị và kho lưu trữ thông tin xác thực hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敏感内容仅保存在本机设置和系统凭据存储中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敏感內容僅保存在本機設定和系統憑證儲存中。"
          }
        }
      }
    },
    "敏感内容仅保存在本机设置和系统凭据存储中。API Token 不进入 CloudKit、导出文件或调试响应记录。" : {
      "comment" : "Privacy explanation for API tokens and sensitive content.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ المحتوى الحساس محليًا فقط في إعدادات الجهاز وتخزين بيانات الاعتماد النظامي. لا يتم إرسال Token API إلى CloudKit أو ملفات التصدير أو سجلات استجابة التصحيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensible Inhalte werden nur in den lokalen Einstellungen und im System-Anmeldedatenspeicher gespeichert. API-Token gelangen nicht in CloudKit, Exportdateien oder Debug-Antwortprotokolle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensitive content is saved only in local settings and the system credential store. API tokens are not stored in CloudKit, export files, or debug response logs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido sensible se guarda solo en los ajustes locales y el almacén de credenciales del sistema. Los tokens de API no se guardan en CloudKit, archivos exportados ni registros de depuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contenu sensible est stocké uniquement dans les réglages locaux et le trousseau système. Les API Token ne sont pas envoyés à CloudKit, ni dans les fichiers exportés ou les réponses de débogage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संवेदनशील सामग्री केवल इस उपकरण की सेटिंग्स और सिस्टम क्रेडेंशियल स्टोरेज में सहेजी जाती है। API Token CloudKit, निर्यात फ़ाइलों या डिबग प्रतिक्रिया रिकॉर्ड में नहीं जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konten sensitif hanya disimpan di pengaturan lokal dan penyimpanan kredensial sistem. API Token tidak masuk ke CloudKit, file ekspor, atau catatan respons debug."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contenuti sensibili sono salvati solo nelle impostazioni locali e nell'archivio credenziali di sistema. L'API Token non viene inviato a CloudKit, file esportati o registri di risposta di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機密コンテンツはこのデバイスの設定とシステム認証情報ストレージにのみ保存されます。API TokenはCloudKit、エクスポートファイル、デバッグ応答記録には保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "민감한 콘텐츠는 기기 설정 및 시스템 자격 증명 저장소에만 저장됩니다. API Token은 CloudKit, 내보내기 파일 또는 디버그 응답 기록에 포함되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gevoelige inhoud wordt alleen lokaal opgeslagen in instellingen en systeemcredentialopslag. API Token wordt niet naar CloudKit, exportbestanden of debugresponslogs gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrażliwe treści są przechowywane tylko w ustawieniach lokalnych i magazynie poświadczeń systemu. Token API nie trafia do CloudKit, plików eksportu ani dzienników odpowiedzi debugowania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteúdo sensível é salvo apenas nas configurações locais e no armazenamento de credenciais do sistema. O Token da API não entra no CloudKit, arquivos exportados ou registros de resposta de depuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Конфиденциальные данные хранятся только в локальных настройках и системном хранилище учётных данных. API Token не передаётся в CloudKit, файлы экспорта или журналы отладки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hassas içerik yalnızca cihaz ayarlarında ve sistem kimlik bilgisi deposunda saklanır. API Token, CloudKit'e, dışa aktarılan dosyalara veya hata ayıklama yanıt kayıtlarına dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung nhạy cảm chỉ được lưu trong cài đặt thiết bị và kho lưu trữ thông tin xác thực hệ thống. API Token không được đưa vào CloudKit, tệp xuất hoặc bản ghi phản hồi gỡ lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敏感内容仅保存在本机设置和系统凭据存储中。API Token 不进入 CloudKit、导出文件或调试响应记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "敏感內容僅保存在本機設定和系統憑證儲存中。API Token 不進入 CloudKit、匯出檔案或除錯回應記錄。"
          }
        }
      }
    },
