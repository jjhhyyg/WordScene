    "此操作会删除全部收藏，并同步到其他设备。" : {
      "comment" : "Warning shown before deleting all saved memory items.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا الإجراء إلى حذف جميع المفضلة ومزامنتها مع الأجهزة الأخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Vorgang löscht alle Favoriten und synchronisiert dies mit anderen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes all saved items and syncs the deletion to your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los guardados y sincroniza la eliminación con tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action supprimera tous les favoris et les synchronisera avec les autres appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्रिया से सभी पसंदीदा हट जाएंगे और अन्य उपकरणों पर सिंक हो जाएंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan menghapus semua favorit dan menyinkronkannya ke perangkat lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione eliminerà tutti i preferiti e li sincronizzerà con altri dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作はすべてのお気に入りを削除し、他のデバイスに同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 모든 즐겨찾기를 삭제하고 다른 기기와 동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden alle favorieten verwijderd en gesynchroniseerd met andere apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta operacja usunie wszystkie ulubione i zsynchronizuje zmiany z innymi urządzeniami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação excluirá todos os favoritos e sincronizará com outros dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие удалит всё избранное и синхронизирует изменения с другими устройствами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm kaydedilenleri siler ve diğer cihazlarla senkronize eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa tất cả mục yêu thích và đồng bộ sang thiết bị khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会删除全部收藏，并同步到其他设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作會刪除全部收藏，並同步到其他裝置。"
          }
        }
      }
    },
    "此操作会清空本机历史，并通过同步删除其他设备上的历史记录。" : {
      "comment" : "Warning shown before deleting all translation history.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا الإجراء إلى مسح السجل المحلي وحذف السجل على الأجهزة الأخرى عبر المزامنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Vorgang löscht den lokalen Verlauf und entfernt ihn über die Synchronisation auch auf anderen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears local history and deletes synced history on your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borra el historial local y elimina el historial sincronizado en tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action effacera l'historique local et supprimera l'historique sur les autres appareils via la synchronisation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस क्रिया से स्थानीय इतिहास साफ़ हो जाएगा और अन्य उपकरणों पर इतिहास भी सिंक द्वारा हट जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan menghapus riwayat lokal dan menghapus riwayat di perangkat lain melalui sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione cancellerà la cronologia locale e rimuoverà la cronologia su altri dispositivi tramite sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
