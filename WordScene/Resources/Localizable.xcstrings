    "主存储初始化失败，当前使用兼容存储：%@" : {
      "comment" : "Persistence status message when primary storage fails. The placeholder is the failure reason.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تهيئة التخزين الأساسي، يتم استخدام التخزين المتوافق حاليًا: %@"
          }
        },
        "de" : {
