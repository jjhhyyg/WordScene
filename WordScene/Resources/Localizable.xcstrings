        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa bộ nhớ cục bộ cũ và bộ đệm lịch sử dịch. Nên xuất bản sao lưu gốc trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
