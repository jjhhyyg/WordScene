          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możliwe korzystanie z sieci komórkowej lub hotspotu – synchronizacja i tłumaczenie mogą generować transfer. Lokalne zapisane i wyszukiwanie nie są dotknięte."
