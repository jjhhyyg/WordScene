    "翻译后点收藏，或手动新增一条本机记忆。" : {
      "comment" : "Empty state description for the saved memory library.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد الترجمة، احفظها في المفضلة أو أضف ذكرى جديدة يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Übersetzung speichern oder manuell einen Eintrag hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save an item after translating, or add a local memory item manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda algo después de traducir o añade manualmente un recuerdo local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la traduction, appuyez sur Favoris ou ajoutez manuellement un souvenir local."
