        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुवाद के बाद पसंदीदा में जोड़ें, या मैन्युअल रूप से एक नई स्थानीय स्मृति जोड़ें।"
          }
        },
        "id" : {
