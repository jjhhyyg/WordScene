    "可以缩短关键词，或尝试拼音、汉字、语言等不同搜索方式。" : {
      "comment" : "Search empty state suggestion.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تقصير الكلمات المفتاحية، أو تجربة طرق بحث مختلفة مثل بينيين، الحروف الصينية، أو اللغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkürzen Sie das Stichwort oder versuchen Sie es mit Pinyin, chinesischen Schriftzeichen oder einer anderen Sprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shorten the query, or try searching by pinyin, Chinese characters, or language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acorta la búsqueda o prueba con pinyin, caracteres chinos o idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de raccourcir le mot-clé ou de chercher en pinyin, caractères chinois ou langue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीवर्ड छोटा करें, या पिनयिन, चीनी अक्षर, भाषा आदि अलग-अलग खोज तरीके आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persingkat kata kunci, atau coba cari dengan pinyin, karakter, atau bahasa lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a ridurre le parole chiave o cerca in pinyin, caratteri cinesi o lingue diverse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーワードを短くするか、拼音、漢字、言語など別の検索方法をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키워드를 줄이거나, 병음, 한자, 언어 등 다른 검색 방식을 시도해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkort zoekwoorden of probeer pinyin, karakters of talen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skróć słowa kluczowe lub spróbuj wyszukać w inny sposób, np. pinyin, znaki chińskie, język."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encurte a palavra-chave ou tente pesquisar em pinyin, caracteres chineses, idiomas, etc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сократите ключевые слова или попробуйте другие способы поиска: пиньинь, иероглифы, язык."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar kelimeyi kısaltın veya pinyin, Çince karakter, dil gibi farklı arama yöntemlerini deneyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có thể rút ngắn từ khóa, hoặc thử tìm kiếm bằng pinyin, chữ Hán, ngôn ngữ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以缩短关键词，或尝试拼音、汉字、语言等不同搜索方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
