{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 到 %@": {
      "comment": "Language direction label. The placeholders are source language and target language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 到 %@"
          }
        }
      }
    },
    "%@失败：%@。%@": {
      "comment": "Sync event message after a failed event. Placeholders are the event label, completion date, and failure reason.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed: %@. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ falló: %@. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@失败：%@。%@"
          }
        }
      }
    },
    "%@已完成：%@。": {
      "comment": "Sync event message after a successful event. Placeholders are the event label and completion date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ completed: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ completado: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已完成：%@。"
          }
        }
      }
    },
    "%@中，开始于 %@。": {
      "comment": "Sync event message while an event is in progress. Placeholders are the event label and start date.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in progress, started at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en curso, comenzó a las %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@中，开始于 %@。"
          }
        }
      }
    },
    "%lld 个结果": {
      "comment": "Summary count for search results. The placeholder is the result count.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld result"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld results"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld resultado"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld resultados"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个结果"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个结果"
                }
              }
            }
          }
        }
      }
    },
    "版本": {
      "comment": "Settings row title for app version.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "保存": {
      "comment": "Save button title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "保存 DeepSeek Token": {
      "comment": "Accessibility label for saving the DeepSeek token.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save DeepSeek Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar token de DeepSeek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 DeepSeek Token"
          }
        }
      }
    },
    "保存 Raw API Response": {
      "comment": "Debug setting title for storing raw API responses.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Raw API Response"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar respuesta API sin procesar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 Raw API Response"
          }
        }
      }
    },
    "保存到收藏": {
      "comment": "Accessibility label for saving a history item to the library.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to Saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar en guardados"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到收藏"
          }
        }
      }
    },
    "保留现有项": {
      "comment": "Import conflict policy that keeps existing saved memory items.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Existing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar existentes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留现有项"
          }
        }
      }
    },
    "备注": {
      "comment": "Section title for the optional note field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备注"
          }
        }
      }
    },
    "本地旧缓存来自更新版本的 App。请先升级 WordScene；不要直接重置，除非已经导出旧缓存原始备份。": {
      "comment": "Recovery error shown when a legacy local cache document requires a newer app version.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legacy local cache was created by a newer version of WordScene. Upgrade first; do not reset it unless you have exported a raw backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché local antigua se creó con una versión más reciente de WordScene. Actualiza primero; no la restablezcas salvo que hayas exportado una copia original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地旧缓存来自更新版本的 App。请先升级 WordScene；不要直接重置，除非已经导出旧缓存原始备份。"
          }
        }
      }
    },
    "本地旧缓存无法读取。请先在“数据存储”导出旧缓存原始备份，再重置旧缓存文档。": {
      "comment": "Recovery error shown when a legacy local cache document cannot be read.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legacy local cache cannot be read. Export its raw backup from Data Storage before resetting legacy cache documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la caché local antigua. Exporta una copia original desde Almacenamiento de datos antes de restablecer esos documentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地旧缓存无法读取。请先在“数据存储”导出旧缓存原始备份，再重置旧缓存文档。"
          }
        }
      }
    },
    "本地数据文件版本不支持：%@ schema_version %lld。请升级 App 后重试。": {
      "comment": "Local persistence error when a legacy data document schema is too new. Placeholders are document key and schema version.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data file version is unsupported: %@ schema_version %lld. Upgrade the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del archivo de datos local no es compatible: %@ schema_version %lld. Actualiza la app e inténtalo de nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据文件版本不支持：%@ schema_version %lld。请升级 App 后重试。"
          }
        }
      }
    },
    "本地数据文件无法读取：%@。": {
      "comment": "Local persistence error when a legacy data document cannot be read. The placeholder is the document key.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data file cannot be read: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer el archivo de datos local: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地数据文件无法读取：%@。"
          }
        }
      }
    },
    "本机数据正在写入主存储。": {
      "comment": "Persistence status message when local data is writing to the primary store.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local data is being written to the primary store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales se están escribiendo en el almacenamiento principal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机数据正在写入主存储。"
          }
        }
      }
    },
    "编辑收藏": {
      "comment": "Title or accessibility label for editing a saved memory item.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Saved Item"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar guardado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑收藏"
          }
        }
      }
    },
    "部分失败 %@": {
      "comment": "Diagnostic label for a partial failure. The placeholder is the failed item identifier.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial Failure %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallo parcial %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分失败 %@"
          }
        }
      }
    },
    "操作失败，请稍后重试。": {
      "comment": "Generic settings operation failure.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation failed. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación falló. Inténtalo de nuevo más tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作失败，请稍后重试。"
          }
        }
      }
    },
    "测试 DeepSeek Token": {
      "comment": "Accessibility label for testing the DeepSeek token.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test DeepSeek Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar token de DeepSeek"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试 DeepSeek Token"
          }
        }
      }
    },
    "测试连接": {
      "comment": "Button title for testing the DeepSeek token.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test Connection"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar conexión"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试连接"
          }
        }
      }
    },
    "词境": {
      "comment": "Root sidebar navigation title.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word Scene"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escena de Palabras"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词境"
          }
        }
      }
    },
    "此操作会清空本机历史，并通过同步删除其他设备上的历史记录。": {
      "comment": "Warning shown before deleting all translation history.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This clears local history and deletes synced history on your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra el historial local y elimina el historial sincronizado en tus otros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会清空本机历史，并通过同步删除其他设备上的历史记录。"
          }
        }
      }
    },
    "此操作会删除全部收藏，并同步到其他设备。": {
      "comment": "Warning shown before deleting all saved memory items.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes all saved items and syncs the deletion to your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los guardados y sincroniza la eliminación con tus otros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会删除全部收藏，并同步到其他设备。"
          }
        }
      }
    },
    "从 iCloud 导入": {
      "comment": "Cloud sync event label for importing from iCloud.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar desde iCloud"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iCloud 导入"
          }
        }
      }
    },
    "待翻译文本": {
      "comment": "Accessibility label for the translation input editor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text to Translate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto para traducir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待翻译文本"
          }
        }
      }
    },
    "当前处于低数据模式，同步和翻译可能由系统延后。本机收藏和搜索不受影响。": {
      "comment": "Network status message for constrained low data mode.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Data Mode is active, so sync and translation may be delayed by the system. Local saved items and search are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de datos reducidos está activo, así que el sistema puede retrasar la sincronización y traducción. Los guardados locales y la búsqueda no se ven afectados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前处于低数据模式，同步和翻译可能由系统延后。本机收藏和搜索不受影响。"
          }
        }
      }
    },
    "当前仅使用本机 Core Data 存储，不会向 iCloud 写入数据。": {
      "comment": "Settings message when local-only storage is active.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is using local Core Data storage only and will not write data to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo usa solo almacenamiento local de Core Data y no escribirá datos en iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅使用本机 Core Data 存储，不会向 iCloud 写入数据。"
          }
        }
      }
    },
    "当前进程没有可用的 CloudKit entitlement，数据仍可本机使用，但不会通过 iCloud 同步。": {
      "comment": "Sync status message when CloudKit entitlements are unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This process has no available CloudKit entitlement. Data remains available locally, but will not sync through iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proceso no tiene entitlement de CloudKit disponible. Los datos siguen disponibles localmente, pero no se sincronizarán mediante iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前进程没有可用的 CloudKit entitlement，数据仍可本机使用，但不会通过 iCloud 同步。"
          }
        }
      }
    },
    "当前可能使用蜂窝或热点网络，同步和翻译可能产生流量。本机收藏和搜索不受影响。": {
      "comment": "Network status message for expensive network connections.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may be using a cellular or hotspot network. Sync and translation may use data. Local saved items and search are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que estés usando una red móvil o punto de acceso. La sincronización y traducción pueden consumir datos. Los guardados locales y la búsqueda no se ven afectados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可能使用蜂窝或热点网络，同步和翻译可能产生流量。本机收藏和搜索不受影响。"
          }
        }
      }
    },
    "当前离线。翻译请求和 iCloud 同步会暂停，但本机收藏、搜索和删除仍可使用。": {
      "comment": "Network status message when offline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. Translation requests and iCloud sync are paused, but local saved items, search, and deletion remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Las solicitudes de traducción y la sincronización con iCloud se pausan, pero los guardados locales, la búsqueda y la eliminación siguen disponibles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前离线。翻译请求和 iCloud 同步会暂停，但本机收藏、搜索和删除仍可使用。"
          }
        }
      }
    },
    "当前使用 iCloud 私有数据库同步收藏和历史。": {
      "comment": "Settings message when iCloud sync is active.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved items and history are syncing through your private iCloud database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los guardados y el historial se sincronizan mediante tu base privada de iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前使用 iCloud 私有数据库同步收藏和历史。"
          }
        }
      }
    },
    "当前为仅本机存储，不会收到 iCloud 同步事件。": {
      "comment": "Sync event status message when using local-only storage.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is using local storage only, so it will not receive iCloud sync events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app usa solo almacenamiento local, así que no recibirá eventos de sincronización de iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前为仅本机存储，不会收到 iCloud 同步事件。"
          }
        }
      }
    },
    "导出": {
      "comment": "Button title for exporting saved memory.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出"
          }
