    "本地数据文件版本不支持：%@ schema_version %lld。请升级 App 后重试。" : {
      "comment" : "Local persistence error when a legacy data document schema is too new. Placeholders are document key and schema version.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصدار ملف البيانات المحلي غير مدعوم: %@ schema_version %lld. يرجى ترقية التطبيق والمحاولة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
