          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta operacja wyczyści lokalną historię i usunie historię na innych urządzeniach przez synchronizację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
