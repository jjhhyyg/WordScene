    "Token 只会保存在本机系统凭据存储中。" : {
      "comment" : "Privacy note for the API token field.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حفظ الرمز فقط في مخزن بيانات اعتماد النظام المحلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token wird nur im lokalen System-Schlüsselspeicher gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token is saved only in this device's system credential store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token se guarda solo en el almacén de credenciales del sistema de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton est stocké uniquement dans le trousseau de l'appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन केवल स्थानीय सिस्टम क्रेडेंशियल स्टोरेज में सहेजा जाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token hanya akan disimpan di penyimpanan kredensial sistem lokal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il token verrà salvato solo nell'archivio credenziali del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token はデバイスのシステム認証情報ストレージにのみ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token은 기기 자격 증명 저장소에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token wordt alleen opgeslagen in de systeemcredentialenopslag van dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token będzie przechowywany tylko w lokalnym magazynie poświadczeń systemu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Token será salvo apenas no armazenamento de credenciais do sistema local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token хранится только в локальном хранилище учётных данных."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token yalnızca cihazınızın kimlik bilgisi deposunda saklanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token chỉ được lưu trong bộ nhớ thông tin xác thực hệ thống cục bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 只会保存在本机系统凭据存储中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 只會儲存在本機系統憑證儲存中。"
          }
        }
      }
    },
    "Token 可认证，但账户余额不可用。请检查 DeepSeek 余额。" : {
      "comment" : "Status shown when DeepSeek accepts a token but balance is unavailable.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرمز صالح، لكن رصيد الحساب غير متاح. يرجى التحقق من رصيد DeepSeek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ist authentifiziert, aber das Kontoguthaben ist nicht verfügbar. Bitte überprüfen Sie Ihr DeepSeek-Guthaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token is valid, but the account balance is unavailable. Check your DeepSeek balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token es válido, pero el saldo de la cuenta no está disponible. Revisa tu saldo de DeepSeek."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton est authentifié, mais le solde du compte n'est pas disponible. Veuillez vérifier votre solde DeepSeek."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन प्रमाणित है, लेकिन खाता शेष उपलब्ध नहीं है। कृपया DeepSeek शेष जांचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
